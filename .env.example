# Secrets are set with `wrangler secret put`, never committed.
# apps/publisher
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=
# Long-lived Instagram User token (Instagram Login), for the daily story (docs/instagram-story.md)
INSTAGRAM_ACCESS_TOKEN=

# packages/media send:marketing: the Telegram group that receives the Instagram/Facebook plan (uses TELEGRAM_BOT_TOKEN)
MARKETING_CHAT_ID=
# packages/media buffer:sync: personal key from publish.buffer.com/settings/api
BUFFER_API_KEY=

# packages/content freeze --upload (R2 API token with Object Read & Write on the bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
